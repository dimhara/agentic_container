FROM python:3.12-slim

# 1. Install System Tools & Playwright OS Dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates git gh less nano unzip tar openssh-client tree \
    libgbm1 libnss3 libasound2 libatk-bridge2.0-0 libgtk-3-0 libpangocairo-1.0-0 \
    libx11-xcb1 libxcomposite1 libxcursor1 libxdamage1 libxfixes3 libxi6 libxrandr2 \
    libxrender1 libxtst6 libcups2 libxss1 libdbus-glib-1-2 pandoc libsixel-bin && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# 2. Create and switch to the agent user
RUN useradd -m -s /bin/bash agent
USER agent
WORKDIR /home/agent

# 3. Set Environment Variables
ENV VIRTUAL_ENV="/home/agent/venv"
ENV PATH="/home/agent/.local/bin:/home/agent/.bun/bin:${VIRTUAL_ENV}/bin:$PATH"

# 4. Install uv natively via pip
RUN pip install --no-cache-dir --user uv

# 5. Create VENV and install aider-chat using the 7-Day UV constraint
ARG CUTOFF_DATE
RUN uv venv $VIRTUAL_ENV && \
    uv pip install --no-cache --exclude-newer "$CUTOFF_DATE" aider-chat

# 6. Install Bun & Symlink to Node (Avoids installing full nodejs)
RUN curl -fsSL https://bun.sh/install | bash && \
    ln -s /home/agent/.bun/bin/bun /home/agent/.bun/bin/node

# 7. Install Opencode and Playwright Browsers
RUN bun install -g opencode-ai @playwright/cli
RUN playwright-cli install-browser chromium && playwright-cli install --skills

# 8. Install Pi
RUN bun add -g --ignore-scripts @earendil-works/pi-coding-agent

# 9. Setup Workspace and automatic init sourcing
RUN mkdir -p /home/agent/workspace && \
    echo '[ -f /home/agent/workspace/init.sh ] && . /home/agent/workspace/init.sh' >> /home/agent/.bashrc

WORKDIR /home/agent/workspace
CMD ["/bin/bash"]
