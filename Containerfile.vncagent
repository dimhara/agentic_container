# Normal refers to the github actions step from its local cache
FROM ghcr.io/dimhara/agentic-sandbox:latest

USER root

# 1. Install Xvnc, noVNC, and fluxbox
RUN apt-get update && apt-get install -y --no-install-recommends \
    tigervnc-standalone-server tigervnc-tools \
    novnc websockify \
    fluxbox file \
    && rm -rf /var/lib/apt/lists/*

USER agent

# 2. Setup VNC credentials
RUN mkdir -p ~/.vnc && \
    echo "password" | vncpasswd -f > ~/.vnc/passwd && \
    chmod 600 ~/.vnc/passwd

# 3. Add the init_gui.sh sourcing to the inherited .bashrc
RUN echo '[ -f /home/agent/workspace/init_gui.sh ] && . /home/agent/workspace/init_gui.sh' >> /home/agent/.bashrc

# 4. Expose the noVNC port
EXPOSE 6080

WORKDIR /home/agent/workspace
CMD ["/bin/bash"]
